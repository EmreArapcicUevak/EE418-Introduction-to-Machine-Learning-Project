{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-native",
    "strict": true,
    "noImplicitAny": false,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@/*": ["frontend/*"]
    },
    "ignoreDeprecations": "6.0",
    "baseUrl": "."
  },
  "include": ["./"],
  "exclude": ["node_modules", "dist", "build"]
}
